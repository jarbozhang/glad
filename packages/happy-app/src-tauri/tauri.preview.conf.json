{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BFELAB (preview)",
  "identifier": "com.bfelab.desktop.preview",
  "build": {
    "beforeBuildCommand": "pnpm exec cross-env APP_ENV=preview APP_TARGET=desktop pnpm exec expo export --platform web --output-dir dist"
  },
  "app": {
    "windows": [
      {
        "title": "BFELAB (preview)",
        "width": 1680,
        "height": 1050,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 22,
          "y": 22
        },
        "hiddenTitle": true
      }
    ]
  }
}
